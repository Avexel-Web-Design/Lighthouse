<%= turbo_stream.update "simulator_results" do %>
  <% if @red_score && @blue_score %>
    <div class="mt-6" aria-live="polite"
         data-controller="simulator"
         data-simulator-red-score-value="<%= @red_score.to_f.round(1) %>"
         data-simulator-blue-score-value="<%= @blue_score.to_f.round(1) %>">
      <h2 class="text-lg font-bold text-white mb-4">Monte Carlo Simulation Results</h2>

      <%# Score Cards %>
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="bg-gray-900 border border-red-500/30 rounded-xl p-4 text-center">
          <p class="text-xs text-red-400 uppercase tracking-wider mb-1">Red Alliance</p>
          <p class="text-4xl font-black text-red-400" data-simulator-target="redScore"><%= @red_score.round(1) %></p>
          <p class="text-xs text-gray-400 mt-1">avg predicted pts</p>
          <p class="text-[11px] font-bold text-red-300 mt-1" data-simulator-target="redWin">Red favored</p>
        </div>

        <div class="flex items-center justify-center">
          <span class="text-2xl font-black text-gray-400">VS</span>
        </div>

        <div class="bg-gray-900 border border-blue-500/30 rounded-xl p-4 text-center">
          <p class="text-xs text-blue-400 uppercase tracking-wider mb-1">Blue Alliance</p>
          <p class="text-4xl font-black text-blue-400" data-simulator-target="blueScore"><%= @blue_score.round(1) %></p>
          <p class="text-xs text-gray-400 mt-1">avg predicted pts</p>
          <p class="text-[11px] font-bold text-blue-300 mt-1" data-simulator-target="blueWin">Blue favored</p>
        </div>
      </div>

      <%# Win Probability (from Monte Carlo) %>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-5 mb-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs text-gray-400 uppercase tracking-wider">Win Probability</h3>
          <span class="text-xs text-gray-400"><%= @simulation[:red_win_pct] + @simulation[:blue_win_pct] < 100 ? "#{(100 - @simulation[:red_win_pct] - @simulation[:blue_win_pct]).round(1)}% tie" : "" %></span>
        </div>
        <div class="flex items-center gap-3 mb-2">
          <span class="text-sm font-bold text-red-400 w-16 text-right"><%= @red_win_pct %>%</span>
          <div class="flex-1 h-6 bg-gray-800 rounded-full overflow-hidden flex" role="progressbar" aria-label="Win probability: Red <%= @red_win_pct %>%, Blue <%= @blue_win_pct %>%" aria-valuenow="<%= @red_win_pct %>" aria-valuemin="0" aria-valuemax="100" aria-valuetext="Red <%= @red_win_pct %>%, Blue <%= @blue_win_pct %>%">
            <div class="h-full bg-gradient-to-r from-red-600 to-red-500 rounded-l-full transition-all" style="width: <%= @red_win_pct %>%"></div>
            <div class="h-full bg-gradient-to-r from-blue-500 to-blue-600 rounded-r-full transition-all" style="width: <%= @blue_win_pct %>%"></div>
          </div>
          <span class="text-sm font-bold text-blue-400 w-16"><%= @blue_win_pct %>%</span>
        </div>

        <% winner_color = @red_win_pct >= @blue_win_pct ? "red" : "blue" %>
        <div class="text-center mt-4 pt-4 border-t border-gray-800">
          <p class="text-xs text-gray-400">Predicted Margin of Victory</p>
          <p class="text-2xl font-bold text-<%= winner_color %>-400 mt-1"><%= @margin.round(1) %> pts</p>
          <p class="text-sm text-<%= winner_color %>-400/70"><%= winner_color.capitalize %> Alliance favored</p>
        </div>
      </div>

      <%# Simulation Details %>
      <div class="bg-gray-900 border border-gray-800 rounded-xl p-4 mb-4">
        <h3 class="text-xs text-gray-400 uppercase tracking-wider mb-3">Simulation Details</h3>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="text-center">
            <p class="text-lg font-bold text-white"><%= @simulation[:red_win_pct] %>%</p>
            <p class="text-xs text-gray-400">Red Win Rate</p>
          </div>
          <div class="text-center">
            <p class="text-lg font-bold text-white"><%= @simulation[:blue_win_pct] %>%</p>
            <p class="text-xs text-gray-400">Blue Win Rate</p>
          </div>
          <div class="text-center">
            <p class="text-lg font-bold text-white"><%= @margin.round(1) %></p>
            <p class="text-xs text-gray-400">Avg Margin</p>
          </div>
          <div class="text-center">
            <p class="text-lg font-bold text-white"><%= (params[:iterations] || 1000).to_i %></p>
            <p class="text-xs text-gray-400">Iterations</p>
          </div>
        </div>
      </div>

      <%# Team Breakdown %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% { "red" => @red_team_stats, "blue" => @blue_team_stats }.each do |color, team_stats| %>
          <div class="bg-gray-900 border border-gray-800 rounded-xl p-4">
            <h3 class="text-xs text-<%= color %>-400 uppercase tracking-wider mb-3"><%= color.capitalize %> Alliance Teams</h3>
            <div class="space-y-2">
              <% (team_stats || []).each do |ts| %>
                <div class="flex items-center justify-between bg-gray-800 rounded-lg px-3 py-2">
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-<%= color %>-400 font-mono"><%= ts[:team].team_number %></span>
                    <span class="text-gray-400 text-xs"><%= ts[:team].nickname %></span>
                  </div>
                  <div class="flex items-center gap-2">
                    <% case ts[:source] %>
                    <% when :scouting %>
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-medium">Scouted</span>
                    <% when :statbotics %>
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-500/15 text-blue-400 font-medium">Statbotics</span>
                    <% when :fallback %>
                      <span class="text-[10px] px-1.5 py-0.5 rounded bg-amber-500/15 text-amber-400 font-medium">Estimated</span>
                    <% end %>
                    <span class="font-mono text-sm text-white font-semibold"><%= ts[:avg].round(1) %> pts</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
